#!/data/data/com.termux/files/usr/bin/tgui-bash
BASE="/data/data/com.termux/files/home/automation"
LOG="$BASE/logs/emergency-overlay.log"
mkdir -p "$BASE/logs"
log(){ printf "[%s] %s\n" "$(date -Is)" "$*" >> "$LOG"; }
log overlay-start
declare -A aparams=()
aparams["$tgc_activity_overlay"]=true
tg_json_send newActivity aparams
activity_response="$(tg_msg_recv)"
case "$activity_response" in
  \[*\]) aid="$(jq -r ".[0]" <<<"$activity_response")" ;;
  *) aid="$activity_response" ;;
esac
if [ -z "$aid" ] || [ "$aid" = null ]; then log "overlay-create-failed response=$activity_response"; exit 1; fi
log "activity=$aid"
declare -A bparams=()
bparams["$tgc_create_text"]=SOS
button="$(tg_create_button "$aid" bparams)"
if [ -z "$button" ]; then log button-create-failed; exit 1; fi
log "button=$button"
log overlay-ready
while true; do
  ev="$(tg_msg_recv_event_blocking)" || { log event-read-failed; exit 1; }
  type="$(tg_event_type "$ev")"
  id="$(tg_event_id "$ev")"
  log "event=$type id=$id"
  [ "$type" = "$tgc_ev_destroy" ] && exit 0
  if [ "$type" = "$tgc_ev_long_click" ] && [ "$id" = "$button" ]; then
    log emergency-triggered
    "$BASE/bin/emergency-action.sh" >> "$BASE/logs/emergency-action.log" 2>&1 &
  fi
done
