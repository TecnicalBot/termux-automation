#!/data/data/com.termux/files/usr/bin/tgui-bash
set -u
BASE="/data/data/com.termux/files/home/automation"
LOG="/data/data/com.termux/files/home/automation/logs/emergency-overlay.log"
mkdir -p "/data/data/com.termux/files/home/automation/logs"
log(){ printf "[%s] %s\n" "2026-09-24 08:25:09" "" >> ""; }
log "overlay-start"
declare -A aparams=()
aparams[]=true
declare -a activity=()
tg_activity_new aparams activity
if [ -z "" ]; then
  log "overlay-create-failed count=0"
  termux-toast "SOS overlay could not start" 2>/dev/null || true
  exit 1
fi
aid=""
log "activity="
declare -A bparams=()
bparams[]="SOS"
button=""
if [ -z "" ]; then log "button-create-failed"; exit 1; fi
log "button="
tg_view_width "" "" 64
tg_view_height "" "" 64
tg_activity_position "" 900 900
log "overlay-ready"
termux-toast "SOS button ready" 2>/dev/null || true
while true; do
  ev=""
  type=""
  id=""
  if [ "" = "" ] && [ "" = "" ]; then
    log "long-click"
    if [ -x "/data/data/com.termux/files/home/automation/bin/emergency-action.sh" ]; then "/data/data/com.termux/files/home/automation/bin/emergency-action.sh" >> "" 2>&1 & fi
  elif [ "" = "" ]; then
    log "destroyed"; exit 0
  fi
done
